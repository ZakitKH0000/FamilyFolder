{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Family Folder",
  "mainBinaryName": "ObshayaPapka",
  "version": "1.5.0",
  "identifier": "com.obshayapapka.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Family Folder",
    "shortDescription": "Family Folder — files, chats and voice messages for your family",
    "longDescription": "Share files, chat and send voice messages between your family computers. Papych brings a quick chat to the top of your screen; optional encrypted cloud delivery works when devices are not online together.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Russian",
          "German",
          "Spanish",
          "French",
          "Portuguese",
          "Turkish",
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh",
        "template": "installer.nsi"
      }
    },
    "licenseFile": "installer-license.txt",
    "copyright": "© 2026 Zakir. All rights reserved."
  }
}
